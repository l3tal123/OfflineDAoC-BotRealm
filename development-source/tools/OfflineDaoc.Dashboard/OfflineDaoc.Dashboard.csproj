<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BotRealm: the launcher and live dashboard. One program, two halves:
      - this host: process control (server and game client), the BotRealm pre-flight, SQLite reads/writes and the
        state-165 file broker, all served as a small loopback HTTP API;
      - wwwroot/: the UI, plain HTML/CSS/JS with Vue 3 vendored, opened in the browser;
      - Launcher/: the launcher-only logic (world content and refresh, the rolling server console log, the
        Godot client launcher, the XP-rate and server-property writes, the bot character generator). Those files carry
        no UI and came over from the retired old launcher, which is no longer in the repository.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BotRealm</AssemblyName>
    <RootNamespace>OfflineDaoc.Dashboard</RootNamespace>
    <Product>BotRealm</Product>
    <AssemblyTitle>BotRealm Launcher and Dashboard</AssemblyTitle>
    <Version>0.3.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
  <ItemGroup>
    <!-- Launcher/ (the files that came from the retired WinForms launcher) is compiled by the default glob. -->
    <Compile Include="../../server/GameServer/bots/autonomous/BotGoalSettings.cs" Link="Configuration/BotGoalSettings.cs" />
    <Compile Include="../../server/GameServer/bots/autonomous/RealmEventRecordStore.cs" Link="Records/RealmEventRecordStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The front-end travels next to the exe in dashboard\wwwroot: one folder, no build step, nothing to install. -->
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
