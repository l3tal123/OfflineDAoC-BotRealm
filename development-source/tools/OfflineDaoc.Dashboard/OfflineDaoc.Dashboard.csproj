<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline DAoC BotRealm: the web dashboard (preview). It is a separate, self-contained tool so the whole
    feature can be removed by deleting this folder and the deployed runtime\dashboard folder. It reads the
    world database read-only and the server's state-165 files, and serves a small local web UI on 127.0.0.1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OfflineDaoc.Dashboard</AssemblyName>
    <RootNamespace>OfflineDaoc.Dashboard</RootNamespace>
    <Product>Offline DAoC: BotRealm Dashboard</Product>
    <AssemblyTitle>Offline DAoC BotRealm live dashboard</AssemblyTitle>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
  <ItemGroup>
    <!-- The front-end travels with the exe: one folder, no build step, nothing to install. -->
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
